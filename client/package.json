{
  "name": "revol-client",
  "private": true,
  "version": "0.1.0",
  "description": "Revol — shared React UI (web / Capacitor mobile / Electron desktop)",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "electron:compile": "tsc -p electron && node scripts/electron-postcompile.mjs",
    "electron:dev": "npm run electron:compile && node scripts/electron-dev.mjs",
    "electron:pack": "npm run build && npm run electron:compile && electron-builder --dir",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --win",
    "electron:publish": "npm run build && npm run electron:compile && electron-builder --win --publish always"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/playfair-display": "^5.2.5",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.66.0",
    "electron-updater": "^6.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-router-dom": "^7.5.0",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  },
  "overrides": {
    "@noble/hashes": "^1.8.0"
  }
}
